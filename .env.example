# Copy to .env (cp .env.example .env) and set JWT_KEY. Everything else is optional for local
# development, where the API uses the local Docker MongoDB from appsettings.Development.json.

# Signing key for login tokens, at least 64 characters (openssl rand -base64 64)
JWT_KEY=

# MongoDB (local database: docker compose up -d)
ConnectionStrings__DbConnection=mongodb://localhost:27017
ConnectionStrings__DatabaseName=test

# Google Maps (geocoding and distance endpoints only)
GoogleMaps__ApiKey=
